    <string name="insight_long_interrupted_title">लंबे सेशन बीच में छूट जाते हैं</string>
    <string name="insight_long_interrupted_message">40 मिनट से लंबे आपके करीब आधे सेशन समय से पहले खत्म हो जाते हैं। इनकी जगह 25–30 मिनट के सेशन आज़माएँ।</string>
    <string name="insight_average_session_title">औसत सेशन: %1$d मिनट</string>
    <string name="insight_average_session_message">आप आमतौर पर एक बार में %1$d मिनट फ़ोकस करते हैं। टाइमर को इसी के हिसाब से सेट करेंगे तो सेशन बीच में कम छूटेंगे।</string>
    <string name="insight_estimation_over_title">मिशन में सोचे से ज़्यादा समय लगता है</string>
    <string name="insight_estimation_over_message">आपके हाल के मिशन में अनुमान से करीब %1$d%% ज़्यादा पोमोडोरो लगे। प्लान बनाते समय एक पोमोडोरो अलग से जोड़ लें।</string>
    <string name="insight_estimation_under_title">आप प्लान से पहले काम पूरा कर लेते हैं</string>
    <string name="insight_estimation_under_message">आप अनुमान से करीब %1$d%% कम पोमोडोरो में मिशन पूरे कर लेते हैं। आप और बड़े लक्ष्य रख सकते हैं।</string>
    <string name="insight_early_stops_title">सेशन अक्सर बीच में छूटते हैं</string>
    <string name="insight_early_stops_message">आपके %1$d%% सेशन समय से पहले खत्म हो जाते हैं। फ़ोकस करते समय नोटिफ़िकेशन म्यूट करें और फ़ोन को पहुँच से दूर रखें।</string>
